# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
# PostgreSQL connection string. SQLAlchemy 2.x picks the psycopg2 driver, so
# force the dialect explicitly when the URL comes from a provider:
#   postgresql+psycopg2://user:password@host:5432/logistics_api
# Supabase session pooler URLs are supported as-is.
DATABASE_URL=postgresql://user:password@localhost:5432/logistics_api

# Long random string, e.g. `openssl rand -hex 32`
SECRET_KEY=change_me_to_a_long_random_value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed browser origins (dashboard + custom domains)
ALLOWED_ORIGINS=http://localhost:8000

# true locally, false in production (debug OTP endpoint is public when true)
DEBUG_MODE=True

# ---------------------------------------------------------------------------
# Transactional email (OTP delivery)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@your-domain.dev

# ---------------------------------------------------------------------------
# Logistics data provider
# ---------------------------------------------------------------------------
RAJA_ONGKIR_API_KEY=your_komerce_shipping_cost_key

# ---------------------------------------------------------------------------
# Crypto payments (Base network, USDC)
# ---------------------------------------------------------------------------
ETHERSCAN_API_KEY=your_etherscan_v2_key
MY_CRYPTO_WALLET=0x_your_wallet_address
USDC_CONTRACT_BASE=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
USDT_CONTRACT_PLASMA=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
USD_PRICE_IDR=17000

# ---------------------------------------------------------------------------
# Static QRIS payments
# ---------------------------------------------------------------------------
QRIS_IMAGE_URL=/assets/img/qrcodes/QRIS_MerchantGopay.jpeg
QRIS_MERCHANT_NAME=Your Merchant Name
# Shared secret for POST /v1/billing/admin/confirm-payment/{order_id}
ADMIN_CONFIRM_TOKEN=change_me

# ---------------------------------------------------------------------------
# Public contact details shown on the dashboard
# ---------------------------------------------------------------------------
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@example.com
ADMIN_WHATSAPP=62xxxxxxxxxx

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
# memory:// keeps rate limiting in-process; point to Redis for multi-instance
REDIS_URL=memory://
