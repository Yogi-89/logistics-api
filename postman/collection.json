{
	"info": {
		"_postman_id": "82e4212d-90f9-4601-aaf5-3bb372eb22f7",
		"name": "Logistics Rate & Tracking API (EAS)",
		"description": "Collection for testing Logistics API endpoints for EAS Pemrograman API.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"password123\",\n    \"email\": \"test@example.com\",\n    \"captcha_token\": \"test-token\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json", "type": "text" },
							{ "key": "X-Captcha-Token", "value": "test-token", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "API Key Management",
			"item": [
				{
					"name": "Generate API Key",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"label\": \"Mobile App\"\n}",
							"options": {
								"raw": { "language": "json" }
							}
						},
						"url": {
							"raw": "{{baseUrl}}/apikey/generate",
							"host": ["{{baseUrl}}"],
							"path": ["apikey", "generate"]
						}
					}
				},
				{
					"name": "List API Keys",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"url": {
							"raw": "{{baseUrl}}/apikey/list",
							"host": ["{{baseUrl}}"],
							"path": ["apikey", "list"]
						}
					}
				}
			]
		},
		{
			"name": "Logistics Data (Needs X-API-Key)",
			"item": [
				{
					"name": "List Couriers",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "X-API-Key", "value": "{{apiKey}}", "type": "text" }
						],
						"url": {
							"raw": "{{baseUrl}}/v1/couriers",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "couriers"]
						}
					}
				},
				{
					"name": "Check Cost",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-API-Key", "value": "{{apiKey}}", "type": "text" },
							{ "key": "Content-Type", "value": "application/json", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"origin\": 1,\n    \"destination\": 2,\n    \"weight\": 1000,\n    \"courier\": \"jne\"\n}",
							"options": {
								"raw": { "language": "json" }
							}
						},
						"url": {
							"raw": "{{baseUrl}}/v1/cost",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "cost"]
						}
					}
				},
				{
					"name": "Create Shipment",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-API-Key", "value": "{{apiKey}}", "type": "text" },
							{ "key": "Content-Type", "value": "application/json", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"courier_id\": 1,\n    \"origin_city_id\": 1,\n    \"destination_city_id\": 2,\n    \"service_type\": \"REG\",\n    \"weight_gram\": 1000,\n    \"sender_name\": \"Yogi Prasetyo\",\n    \"sender_phone\": \"081234567890\",\n    \"sender_address\": \"Jl. Testing No. 123, Jakarta\",\n    \"receiver_name\": \"Customer Satu\",\n    \"receiver_phone\": \"082345678901\",\n    \"receiver_address\": \"Jl. Penerima No. 456, Bandung\"\n}",
							"options": {
								"raw": { "language": "json" }
							}
						},
						"url": {
							"raw": "{{baseUrl}}/v1/shipments",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "shipments"]
						}
					}
				},
				{
					"name": "Track Package",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "X-API-Key", "value": "{{apiKey}}", "type": "text" }
						],
						"url": {
							"raw": "{{baseUrl}}/v1/tracking/LGS-12345678",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "tracking", "LGS-12345678"]
						}
					}
				},
				{
					"name": "Update Tracking",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-API-Key", "value": "{{apiKey}}", "type": "text" }
						],
						"url": {
							"raw": "{{baseUrl}}/v1/tracking/LGS-12345678/update?status=IN_TRANSIT&location=Jakarta&note=Package%20departed",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "tracking", "LGS-12345678", "update"],
							"query": [
								{ "key": "status", "value": "IN_TRANSIT" },
								{ "key": "location", "value": "Jakarta" },
								{ "key": "note", "value": "Package departed" }
							]
						}
					}
				},
				{
					"name": "Generate Shipping Label",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "X-API-Key", "value": "{{apiKey}}", "type": "text" }
						],
						"url": {
							"raw": "{{baseUrl}}/v1/label/LGS-12345678?lang=id",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "label", "LGS-12345678"],
							"query": [
								{ "key": "lang", "value": "id" }
							]
						}
					}
				},
				{
					"name": "Quota Status",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "X-API-Key", "value": "{{apiKey}}", "type": "text" }
						],
						"url": {
							"raw": "{{baseUrl}}/v1/quota",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "quota"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8000" },
		{ "key": "token", "value": "" },
		{ "key": "apiKey", "value": "" }
	]
}
